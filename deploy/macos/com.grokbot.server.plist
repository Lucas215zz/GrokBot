<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Grok Bot 云计算机服务端 —— launchd 用户代理

  安装位置：~/Library/LaunchAgents/com.grokbot.server.plist
  由 deploy/macos/setup.sh 自动生成（会把 __ 占位符替换成真实路径）。

  为什么用 LaunchAgent 而不是 LaunchDaemon：
    LaunchDaemon 跑在 Session 0，没有 GUI 会话，Chrome 起不来、截图黑屏。
    浏览器自动化必须跑在登录用户的可视会话里，所以只能用 LaunchAgent。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.grokbot.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__SERVER__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- 崩了自动拉起；正常退出（退出码 0）也拉起，保证常驻 -->
  <key>KeepAlive</key>
  <true/>

  <!-- 别让 launchd 因为「启动太快」限流 -->
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>__LOG__/grok-server.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG__/grok-server.err.log</string>

  <!--
    launchd 的默认 PATH 只有 /usr/bin:/bin:/usr/sbin:/sbin，
    Homebrew 装的 node / git / python 全找不到。必须显式补。
    Apple Silicon 是 /opt/homebrew，Intel 是 /usr/local。
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>

  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
